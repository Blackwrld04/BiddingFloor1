# ==============================================================================
# CognitiveSwarm Environment Configuration
# ==============================================================================

# ⚡ Groq LPU API Configuration (Powering Real-Time Multi-Agent Reasoning)
# Get your free/instant key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model choices:
# - llama-3.3-70b-versatile  (Recommended: State-of-the-art 70B reasoning)
# - llama-3.1-8b-instant     (Extreme low latency: ~100ms response time)
# - mixtral-8x7b-32768       (Fast MoE architecture)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SEC=2.5

# 🔬 Sponsor Ecosystem Mode
# Sets simulated/sample telemetry adapters for NVIDIA, Meterless, & Zetaris
SAMPLE_MODE=true
